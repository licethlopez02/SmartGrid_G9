meta {
  name: 05 - Rechazar factura duplicada
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/facturas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "medidorId": {{medidorId}},
    "periodoInicio": "2025-01-01",
    "periodoFin": "2025-01-31",
    "consumoAcumuladoKwh": 120.5,
    "periodoCompleto": true,
    "tarifaValor": 650.00,
    "tarifaVigenciaDesde": "2020-01-01",
    "tarifaVigenciaHasta": "2030-12-31"
  }
}

tests {
  test("No permite generar dos facturas para el mismo periodo", function() {
    expect(res.status).to.equal(409);
    expect(res.body).to.have.property("mensaje");
  });
}

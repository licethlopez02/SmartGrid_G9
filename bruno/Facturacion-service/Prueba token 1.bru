meta {
  name: Prueba token
  type: http
  seq: 11
}

post {
  url: http://localhost:8000/api/auth/login
  body: json
  auth: none
}

body:json {
    {
      "correo": "operador@smartgrid.local",
      "contrasena": "Operador123!"
    }
}

script:post-response {
  bru.setEnvVar("tokenOP", res.body.token);
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

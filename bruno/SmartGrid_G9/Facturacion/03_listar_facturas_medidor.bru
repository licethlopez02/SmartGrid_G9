meta {
  name: 03 - Listar facturas de un medidor
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/facturas?medidorId={{medidorId}}
  body: none
  auth: none
}

tests {
  test("El listado incluye la factura creada para el medidor", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    const facturaId = Number(bru.getEnvVar("facturaId"));
    expect(res.body.some((factura) => factura.id === facturaId)).to.equal(true);
  });
}

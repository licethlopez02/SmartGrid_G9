meta {
  name: 02 - Consultar factura creada
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/facturas/{{facturaId}}
  body: none
  auth: none
}

tests {
  test("La factura creada se puede consultar por id", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(Number(bru.getEnvVar("facturaId")));
    expect(res.body.medidorId).to.equal(Number(bru.getEnvVar("medidorId")));
  });
}

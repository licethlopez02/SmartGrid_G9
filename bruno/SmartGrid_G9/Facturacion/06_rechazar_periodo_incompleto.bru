meta {
  name: 06 - Rechazar periodo incompleto
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/facturas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "medidorId": {{medidorSinFactura}},
    "periodoInicio": "2025-02-01",
    "periodoFin": "2025-02-28",
    "consumoAcumuladoKwh": 35.0,
    "periodoCompleto": false,
    "tarifaValor": 650.00,
    "tarifaVigenciaDesde": "2020-01-01",
    "tarifaVigenciaHasta": "2030-12-31"
  }
}

tests {
  test("No genera factura para un periodo incompleto", function() {
    expect(res.status).to.equal(409);
    expect(res.body).to.have.property("mensaje");
  });
}

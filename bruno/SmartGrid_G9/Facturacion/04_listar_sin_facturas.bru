meta {
  name: 04 - Listar medidor sin facturas
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/facturas?medidorId={{medidorSinFactura}}
  body: none
  auth: none
}

tests {
  test("Un medidor sin facturas devuelve una lista vacia", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array").that.is.empty;
  });
}

meta {
  name: 03 - Registro con datos invalidos (400)
  type: http
  seq: 3
}

post {
  url: {{usuariosUrl}}/api/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "",
    "correo": "no-es-un-correo",
    "contrasena": "123"
  }
}

tests {
  test("responde 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("el mensaje menciona los campos invalidos", function () {
    expect(res.getBody().mensaje).to.include("correo");
    expect(res.getBody().mensaje).to.include("contrasena");
  });
}

meta {
  name: 12a - Nuevo login de Ana con ambos roles (200)
  type: http
  seq: 12
}

post {
  url: {{usuariosUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{correoAna}}",
    "contrasena": "{{contrasenaAna}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("tokenAmbosRoles", res.getBody().token);
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Guarda el token en tokenAmbosRoles. Pega ese token en jwt.io para ver el claim roles con USUARIO y OPERADOR (captura 09).
}

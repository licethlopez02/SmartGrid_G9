meta {
  name: 05 - Login con contrasena incorrecta (401)
  type: http
  seq: 5
}

post {
  url: {{usuariosUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{correoAna}}",
    "contrasena": "otraClave99"
  }
}

tests {
  test("responde 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

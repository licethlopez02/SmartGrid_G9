meta {
  name: 14b - Login de Ana con la cuenta desactivada (401)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{correoAna}}",
    "contrasena": "{{contrasenaAna}}"
  }
}

tests {
  test("responde 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
